# ---- platform (required) ----
ENVIRONMENT=dev                      # dev | staging | prod  (prod disables /api/docs and enables HSTS)
SECRET_KEY=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
NEXUS_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
DATA_RESIDENCY_REGION=EU
JURISDICTIONS=["PT","EU","AO"]

# ---- AI providers (at least one) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
AI_DEFAULT_PROVIDER=auto             # auto | anthropic | gemini
AI_PII_REDACTION=true

# ---- GRC systems of record (any; per-organization overrides are set in the UI, encrypted) ----
# e.g. http://localhost:8443
CISO_ASSISTANT_URL=
CISO_ASSISTANT_TOKEN=
SIMPLERISK_URL=
SIMPLERISK_API_KEY=
ERAMBA_URL=
ERAMBA_API_KEY=
ONETRUST_URL=
ONETRUST_API_KEY=
ARCHER_URL=
ARCHER_INSTANCE=
ARCHER_USERNAME=
ARCHER_PASSWORD=

# ---- security tooling ----
# https://wazuh-manager:55000
WAZUH_URL=
WAZUH_USER=
WAZUH_PASSWORD=
# https://wazuh-indexer:9200
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_TLS=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_IDS=[]

# ---- ITSM / collaboration ----
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
TEAMS_WEBHOOK_URL=

# ---- scheduler ----
SCHEDULER_ENABLED=true
EVIDENCE_SYNC_CRON=0 */6 * * *
ALERT_TRIAGE_CRON=*/15 * * * *

# ---- bootstrap ----
# used by `python -m app.cli seed-demo` / create-user
NEXUS_BOOTSTRAP_PASSWORD=
# optional folder with extra content packs (your own frameworks)
NEXUS_CONTENT_DIR=
# optional local folder imported into the Repository as a document library (e.g. a synced Google Drive folder);
# mounted read-only, never committed. Import with: docker compose exec backend python -m app.cli library-import
NEXUS_LIBRARY_HOST=
